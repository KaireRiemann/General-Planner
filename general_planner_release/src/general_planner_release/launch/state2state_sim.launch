<launch>
  <arg name="planner_backend" default="corridor"/>
  <arg name="sim_config" default="click.yaml"/>
  <arg name="rviz" default="true"/>
  <arg name="rviz_config" default="$(find perfect_drone_sim)/rviz/release.rviz"/>

  <node pkg="perfect_drone_sim"
        type="perfect_drone"
        name="perfect_drone"
        output="log"
        clear_params="true">
    <param name="config_name" value="$(arg sim_config)" type="string"/>
  </node>

  <include file="$(find general_planner_release)/launch/state2state.launch">
    <arg name="planner_backend" value="$(arg planner_backend)"/>
  </include>

  <group if="$(arg rviz)">
    <node pkg="rviz" type="rviz" name="release"
          args="-d $(arg rviz_config)" output="log"/>
  </group>
</launch>
