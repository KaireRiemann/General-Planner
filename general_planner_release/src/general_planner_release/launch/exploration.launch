<launch>
  <!-- Planner-only entry: use with real sensors, rosbag, or an external simulator. -->
  <arg name="exploration_config"
       default="$(find general_planner_release)/config/exploration.yaml"/>
  <arg name="exploration_overlay_config" default=""/>
  <arg name="indoor_frontier_config"
       default=""/>
  <!-- Empty preserves the mission in the base YAML; coverage selects EPICON. -->
  <arg name="exploration_mission_mode" default=""/>
  <arg name="map_config"
       default="$(find general_planner_release)/config/map.yaml"/>

  <arg name="odom_topic" default="/lidar_slam/odom"/>
  <arg name="cloud_topic" default="/cloud_registered"/>
  <arg name="trigger_topic" default="/move_base_simple/goal"/>
  <arg name="legacy_trigger_topic" default=""/>
  <!-- planner_runtime serial handover: disable local RViz triggers and take
       START/PAUSE only from /planning/exploration/command. -->
  <arg name="task_control_enable" default="false"/>
  <arg name="disable_local_trigger" default="false"/>
  <arg name="pos_cmd_topic" default="/planning/pos_cmd"/>
  <arg name="traj_server" default="true"/>

  <node pkg="general_planner_release"
        type="exploration_node"
        name="exploration_node"
        output="screen"
        clear_params="true">
    <!-- Dynamic bounding-box selection is configured by exploration.yaml. -->
    <rosparam file="$(arg exploration_config)" command="load"/>
    <rosparam file="$(arg map_config)" command="load"/>
    <rosparam if="$(eval arg('exploration_overlay_config') != '')"
              file="$(arg exploration_overlay_config)" command="load"/>
    <rosparam if="$(eval arg('indoor_frontier_config') != '')"
              file="$(arg indoor_frontier_config)" command="load"/>
    <param if="$(eval arg('exploration_mission_mode') != '')"
           name="exploration/mission_mode"
           value="$(arg exploration_mission_mode)" type="string"/>

    <param name="odometry_topic" value="$(arg odom_topic)" type="string"/>
    <param name="cloud_topic" value="$(arg cloud_topic)" type="string"/>
    <param name="RogMapConfigPath" value="$(arg map_config)" type="string"/>
    <param unless="$(arg disable_local_trigger)"
           name="fsm/trigger_topic" value="$(arg trigger_topic)" type="string"/>
    <param if="$(arg disable_local_trigger)"
           name="fsm/trigger_topic" value="" type="string"/>
    <param unless="$(arg disable_local_trigger)"
           name="fsm/legacy_trigger_topic"
           value="$(arg legacy_trigger_topic)" type="string"/>
    <param if="$(arg disable_local_trigger)"
           name="fsm/legacy_trigger_topic" value="" type="string"/>
    <param name="fsm/task_control_enable"
           value="$(arg task_control_enable)" type="bool"/>
    <param name="fsm/task_command_topic"
           value="/planning/exploration/command" type="string"/>
    <param name="fsm/task_status_topic"
           value="/planning/exploration/status" type="string"/>
    <param name="fsm/execution_enabled_topic"
           value="/planning/exploration/command_enabled" type="string"/>
    <param name="fsm/handover_slow_speed" value="0.10" type="double"/>
  </node>

  <node if="$(arg traj_server)"
        pkg="general_planner_release"
        type="highspeed_traj_server"
        name="highspeed_traj_server"
        output="screen">
    <rosparam file="$(arg exploration_config)" command="load"/>
    <param name="odometry_topic" value="$(arg odom_topic)" type="string"/>
    <param name="pos_cmd_topic" value="$(arg pos_cmd_topic)" type="string"/>
    <param name="execution_enabled_topic"
           value="/planning/exploration/command_enabled" type="string"/>
  </node>
</launch>
