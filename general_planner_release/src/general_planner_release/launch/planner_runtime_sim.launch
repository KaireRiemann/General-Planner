<launch>
  <!-- M2 simulator convenience entry.  It delegates all planner ownership to
       planner_runtime.launch and only selects the bundled perfect_drone sim. -->
  <arg name="rviz" default="true" />
  <arg name="auto_rviz_switch" default="true" />
  <arg name="traj_server" default="true" />
  <arg name="initial_mode" default="exploration" />
  <arg name="enable_exploration" default="true" />
  <arg name="sim_config" default="$(find general_planner_release)/config/exploration_sim.yaml" />
  <arg name="navigation_config" default="$(find general_planner_release)/config/task_planner_runtime_state2state.yaml" />
  <arg name="exploration_config" default="$(find general_planner_release)/config/exploration_house.yaml" />
  <arg name="rog_map_config" default="$(find general_planner_release)/config/exploration_rog_map.yaml" />
  <arg name="global_topology_config" default="$(find general_planner_release)/config/global_topology.yaml" />
  <arg name="rviz_config" default="$(find general_planner_release)/config/planner_runtime_exploration.rviz" />
  <arg name="exploration_rviz_config" default="$(find general_planner_release)/config/planner_runtime_exploration.rviz" />
  <arg name="state2state_rviz_config" default="$(find general_planner_release)/config/planner_runtime_state2state.rviz" />
  <arg name="odom_topic" default="/lidar_slam/odom" />
  <arg name="cloud_topic" default="/cloud_registered" />

  <include file="$(find general_planner_release)/launch/planner_runtime.launch">
    <arg name="marsim" value="true" />
    <arg name="rviz" value="$(arg rviz)" />
    <arg name="auto_rviz_switch" value="$(arg auto_rviz_switch)" />
    <arg name="traj_server" value="$(arg traj_server)" />
    <arg name="initial_mode" value="$(arg initial_mode)" />
    <arg name="enable_exploration" value="$(arg enable_exploration)" />
    <arg name="sim_config" value="$(arg sim_config)" />
    <arg name="navigation_config" value="$(arg navigation_config)" />
    <arg name="exploration_config" value="$(arg exploration_config)" />
    <arg name="rog_map_config" value="$(arg rog_map_config)" />
    <arg name="global_topology_config" value="$(arg global_topology_config)" />
    <arg name="rviz_config" value="$(arg rviz_config)" />
    <arg name="exploration_rviz_config" value="$(arg exploration_rviz_config)" />
    <arg name="state2state_rviz_config" value="$(arg state2state_rviz_config)" />
    <arg name="odom_topic" value="$(arg odom_topic)" />
    <arg name="cloud_topic" value="$(arg cloud_topic)" />
  </include>
</launch>
