<launch>
  <!-- Unified planner runtime (binary release, planner-only):
       exploration -> serial handover -> state2state via general_planner_runtime_node
       Mode-switched RViz: LIO+traj / sliding ROG+fsm traj.

       For garage sim testing use planner_runtime_sim.launch (starts perfect_drone).
       With external sensors / rosbag:
         roslaunch general_planner_release planner_runtime.launch
  -->
  <arg name="marsim" default="false" />
  <arg name="rviz" default="true" />
  <arg name="auto_rviz_switch" default="true" />
  <arg name="traj_server" default="true" />
  <arg name="initial_mode" default="exploration" />
  <arg name="serial_handover" default="true" />
  <arg name="enable_navigation" default="false" />
  <arg name="enable_exploration" default="true" />

  <arg name="sim_config"
       default="$(find general_planner_release)/config/exploration_sim.yaml" />
  <arg name="navigation_config"
       default="$(find general_planner_release)/config/interface_state2state_corridor.yaml" />
  <arg name="generated_config_path"
       default="$(env HOME)/.ros/general_planner_runtime/planner_runtime_state2state.yaml" />
  <!-- Match task_planner/planner_runtime.launch: house box contains sim spawn (-17,0,2).
       The garage exploration.yaml box previously started at x=-10 and left the
       drone outside the exploration region (topology start_fail, no traj). -->
  <arg name="exploration_config"
       default="$(find general_planner_release)/config/exploration_house.yaml" />
  <arg name="rog_map_config"
       default="$(find general_planner_release)/config/exploration_rog_map.yaml" />
  <arg name="rviz_config"
       default="$(find general_planner_release)/config/planner_runtime_exploration.rviz" />
  <arg name="exploration_rviz_config"
       default="$(find general_planner_release)/config/planner_runtime_exploration.rviz" />
  <arg name="state2state_rviz_config"
       default="$(find general_planner_release)/config/planner_runtime_state2state.rviz" />

  <arg name="odom_topic" default="/lidar_slam/odom" />
  <arg name="cloud_topic" default="/cloud_registered" />
  <arg name="coverage_guidance_mode" default="full" />

  <arg name="fsm_replan_time" default="0.25" />
  <arg name="fsm_replan_time_after_traj_start" default="0.35" />
  <arg name="fsm_replan_time_before_traj_end" default="1.0" />
  <arg name="global_path_update_min_interval" default="0.2" />
  <arg name="cloud_subscriber_queue" default="1" />
  <arg name="odom_subscriber_queue" default="50" />
  <arg name="sync_queue" default="20" />
  <arg name="cloud_odom_mode" default="approximate_sync" />
  <arg name="latest_odom_timeout" default="0.5" />
  <arg name="max_cloud_age" default="0.5" />
  <arg name="heartbeat_timeout" default="1.5" />
  <arg name="task_control_enable" default="true" />

  <arg name="original_frontend_compatibility" default="true" />
  <arg name="use_lkh" default="true" />
  <arg name="tsp_dir" default="/tmp" />
  <arg name="rog_map_enable" default="true" />
  <arg name="bubble_astar_allocate_num" default="1000000" />
  <arg name="bubble_astar_lambda_heu" default="100.0" />
  <arg name="bubble_astar_resolution" default="0.25" />
  <arg name="bubble_topo_cube_discrete_size" default="0.30" />

  <arg name="view_graph" default="false" />
  <arg name="view_frontier" default="true" />
  <arg name="view_cluster" default="true" />

  <node if="$(arg marsim)" pkg="perfect_drone_sim" type="perfect_drone"
        name="perfect_drone" output="screen" clear_params="true">
    <param name="config_path" value="$(arg sim_config)" type="string" />
  </node>

  <node if="$(arg enable_exploration)" pkg="general_planner_release"
        type="exploration_node" name="exploration_node"
        output="screen" clear_params="true">
    <rosparam file="$(arg exploration_config)" command="load" />

    <param name="odometry_topic" value="$(arg odom_topic)" type="string" />
    <param name="cloud_topic" value="$(arg cloud_topic)" type="string" />
    <param name="RogMapEnable" value="$(arg rog_map_enable)" type="bool" />
    <param name="RogMapConfigPath" value="$(arg rog_map_config)" type="string" />

    <param name="view_graph" value="$(arg view_graph)" type="bool" />
    <param name="FrontierManager/view_frt" value="$(arg view_frontier)" type="bool" />
    <param name="FrontierManager/view_cluster" value="$(arg view_cluster)" type="bool" />

    <param name="fsm/thresh_replan" value="0.5" type="double" />
    <param name="fsm/emergency_replan_control_error" value="1.5" type="double" />
    <param name="fsm/replan_time" value="$(arg fsm_replan_time)" type="double" />
    <param name="fsm/replan_time_after_traj_start"
           value="$(arg fsm_replan_time_after_traj_start)" type="double" />
    <param name="fsm/replan_time_before_traj_end"
           value="$(arg fsm_replan_time_before_traj_end)" type="double" />
    <param name="fsm/debug_planner" value="false" type="bool" />
    <param name="fsm/auto_trigger" value="false" type="bool" />
    <param name="coverage_guidance/mode"
           value="$(arg coverage_guidance_mode)" type="string" />
    <param name="fsm/global_path_update_min_interval"
           value="$(arg global_path_update_min_interval)" type="double" />
    <param name="fsm/cloud_subscriber_queue"
           value="$(arg cloud_subscriber_queue)" type="int" />
    <param name="fsm/odom_subscriber_queue"
           value="$(arg odom_subscriber_queue)" type="int" />
    <param name="fsm/sync_queue" value="$(arg sync_queue)" type="int" />
    <param name="fsm/cloud_odom_mode"
           value="$(arg cloud_odom_mode)" type="string" />
    <param name="fsm/latest_odom_timeout"
           value="$(arg latest_odom_timeout)" type="double" />
    <param name="fsm/max_cloud_age" value="$(arg max_cloud_age)" type="double" />
    <param name="fsm/task_control_enable"
           value="$(arg task_control_enable)" type="bool" />
    <param name="fsm/task_command_topic"
           value="/planning/exploration/command" type="string" />
    <param name="fsm/task_status_topic"
           value="/planning/exploration/status" type="string" />
    <param name="fsm/execution_enabled_topic"
           value="/planning/exploration/command_enabled" type="string" />
    <param name="fsm/trigger_topic" value="" type="string" />
    <param name="fsm/legacy_trigger_topic" value="" type="string" />
    <param name="fsm/handover_slow_speed" value="0.10" type="double" />

    <param name="exploration/original_frontend_compatibility"
           value="$(arg original_frontend_compatibility)" type="bool" />
    <param name="exploration/use_lkh" value="$(arg use_lkh)" type="bool" />
    <param name="exploration/tsp_dir" value="$(arg tsp_dir)" type="string" />
    <param name="bubble_astar/allocate_num"
           value="$(arg bubble_astar_allocate_num)" type="int" />
    <param name="bubble_astar/lambda_heu"
           value="$(arg bubble_astar_lambda_heu)" type="double" />
    <param name="bubble_astar/debug" value="false" type="bool" />
    <param name="bubble_astar/resolution_astar"
           value="$(arg bubble_astar_resolution)" type="double" />
    <param name="bubble_topo/cube_discrete_size"
           value="$(arg bubble_topo_cube_discrete_size)" type="double" />
  </node>

  <node if="$(arg traj_server)" pkg="general_planner_release"
        type="highspeed_traj_server" name="highspeed_traj_server" output="screen">
    <param name="odometry_topic" value="$(arg odom_topic)" type="string" />
    <param name="replan_time" value="$(arg fsm_replan_time)" type="double" />
    <param name="heartbeat_timeout" value="$(arg heartbeat_timeout)" type="double" />
    <param name="pos_cmd_topic" value="/planning/exploration/pos_cmd" type="string" />
    <param name="execution_enabled_topic"
           value="/planning/exploration/command_enabled" type="string" />
  </node>

  <node if="$(arg serial_handover)" pkg="general_planner_release"
        type="planner_serial_handover.py" name="planner_serial_handover"
        output="screen">
    <param name="fsm_package" value="general_planner_release" type="string" />
    <param name="fsm_type" value="general_planner_runtime_node" type="string" />
    <param name="fsm_node_name" value="fsm_node" type="string" />
    <param name="fsm_config_param" value="interface_config_path" type="string" />
    <param name="fsm_config_path" value="$(arg navigation_config)" type="string" />
    <param name="fsm_extra_args"
           value="_generated_config_path:=$(arg generated_config_path)"
           type="string" />
    <param name="exploration_launch_pkg" value="general_planner_release" type="string" />
    <param name="exploration_launch_file" value="exploration.launch" type="string" />
    <!-- Must mirror the exploration_node / traj_server wiring above so a
         state2state -> exploration relaunch still accepts
         /planner/exploration/trigger via /planning/exploration/command. -->
    <param name="exploration_launch_args"
           value="traj_server:=true task_control_enable:=true disable_local_trigger:=true pos_cmd_topic:=/planning/exploration/pos_cmd exploration_config:=$(arg exploration_config) rog_map_config:=$(arg rog_map_config) odom_topic:=$(arg odom_topic) cloud_topic:=$(arg cloud_topic) cloud_odom_mode:=$(arg cloud_odom_mode) coverage_guidance_mode:=$(arg coverage_guidance_mode) bubble_astar_resolution:=$(arg bubble_astar_resolution) bubble_topo_cube_discrete_size:=$(arg bubble_topo_cube_discrete_size) view_graph:=$(arg view_graph) view_frontier:=$(arg view_frontier) view_cluster:=$(arg view_cluster)"
           type="string" />
    <param name="handover_command_topic" value="/planner/handover" type="string" />
    <param name="handover_status_topic" value="/planner/handover_status" type="string" />
  </node>

  <node pkg="general_planner_release" type="planner_runtime_node"
        name="planner_runtime_node" output="screen">
    <param name="initial_mode" value="$(arg initial_mode)" type="string" />
    <param name="navigation_enabled" value="$(arg enable_navigation)" type="bool" />
    <param name="exploration_enabled" value="$(arg enable_exploration)" type="bool" />
    <param name="serial_handover" value="$(arg serial_handover)" type="bool" />
    <param name="odometry_topic" value="$(arg odom_topic)" type="string" />
    <param name="navigation_cmd_topic" value="/planning/navigation/pos_cmd" type="string" />
    <param name="exploration_cmd_topic" value="/planning/exploration/pos_cmd" type="string" />
    <param name="output_cmd_topic" value="/planning/pos_cmd" type="string" />
    <param name="exploration_command_topic" value="/planning/exploration/command" type="string" />
    <param name="exploration_status_topic" value="/planning/exploration/status" type="string" />
    <param name="navigation_command_topic" value="/planning/navigation/command" type="string" />
    <param name="navigation_status_topic" value="/planning/navigation/status" type="string" />
    <param name="navigation_task_mode_topic" value="/planning/navigation_task_mode" type="string" />
    <param name="navigation_goal_out_topic" value="/planning/click_goal" type="string" />
    <param name="click_demo_goal_topic" value="/goal" type="string" />
    <param name="handover_command_topic" value="/planner/handover" type="string" />
    <param name="handover_status_topic" value="/planner/handover_status" type="string" />
    <param name="hover_speed_threshold" value="0.10" type="double" />
    <param name="hover_yaw_rate_threshold" value="0.10" type="double" />
    <param name="hover_hold_duration" value="0.50" type="double" />
    <param name="max_odom_age" value="0.20" type="double" />
  </node>

  <group if="$(arg rviz)">
    <node unless="$(arg auto_rviz_switch)" pkg="rviz" type="rviz"
          name="rvizvisualisation" output="log"
          args="-d $(arg rviz_config)" />
    <node if="$(arg auto_rviz_switch)" pkg="general_planner_release"
          type="planner_rviz_switcher.py" name="planner_rviz_switcher"
          output="screen">
      <param name="rviz_node_name" value="rvizvisualisation" type="string" />
      <param name="exploration_rviz_config"
             value="$(arg exploration_rviz_config)" type="string" />
      <param name="state2state_rviz_config"
             value="$(arg state2state_rviz_config)" type="string" />
      <param name="hold_rviz_config"
             value="$(arg exploration_rviz_config)" type="string" />
      <param name="initial_mode" value="$(arg initial_mode)" type="string" />
      <param name="status_topic" value="/planner/status" type="string" />
      <param name="handover_status_topic"
             value="/planner/handover_status" type="string" />
    </node>
    <node pkg="tf" type="static_transform_publisher" name="exploration_world_tf"
          args="0 0 0 0 0 0 world navigation 100" />
  </group>
</launch>
