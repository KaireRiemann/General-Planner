#!/usr/bin/env bash
# Isolate detector discovery from a previously sourced development workspace.
# These frontends need only this release, system ROS Noetic and Python packages.
set -e
_detector_pkg_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_detector_release_dir="$(cd "${_detector_pkg_dir}/../.." && pwd)"
source /opt/ros/noetic/setup.bash
export ROS_PACKAGE_PATH="${_detector_release_dir}/src:/opt/ros/noetic/share"
export CMAKE_PREFIX_PATH="/opt/ros/noetic"
export PYTHONPATH="${_detector_release_dir}/lib/python3/dist-packages:/opt/ros/noetic/lib/python3/dist-packages"
export LD_LIBRARY_PATH="${_detector_release_dir}/lib:/opt/ros/noetic/lib"
export PYTHONDONTWRITEBYTECODE=1
exec /usr/bin/python3 "${_detector_pkg_dir}/planner_detector_switcher.py" "$@"
