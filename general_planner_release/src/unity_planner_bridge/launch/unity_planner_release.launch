<launch>
  <!-- Perception is shipped with the release; no source Perceptor packages. -->
  <arg name="gate_config" default="$(find general_planner_release)/config/gate_runtime.yaml" />
  <arg name="gate_overlay_config" default="$(find general_planner_release)/config/gate_unity.yaml" />
  <arg name="perceptor" default="true" />
  <arg name="perceptor_config" default="$(find general_planner_release)/../aperture_detector/config/polygon_hole_step_viz_unity_sim.yaml" />
  <arg name="perceptor_vlm" default="true" />
  <arg name="perceptor_frame_id" default="world" />
  <arg name="perceptor_image_topic" default="/camera0/color/image/compressed" />
  <arg name="perceptor_camera_info_topic" default="/camera0/color/info" />
  <arg name="perceptor_vlm_model" default="auto" />
  <arg name="perceptor_vlm_timeout" default="10.0" />
  <arg name="perceptor_vlm_period" default="3.0" />
  <arg name="perceptor_vlm_base_url" default="http://127.0.0.1:18000/v1" />
  <arg name="tracking_detector" default="true" />
  <arg name="tracking_camera_info_topic" default="/camera0/color/info" />
  <arg name="tracking_rgb_compressed" default="true" />
  <arg name="tracking_depth_topic" default="/camera0/depth/image/compressed" />
  <arg name="tracking_range_method" default="ground_plane" />
  <arg name="tracking_depth_registered" default="false" />
  <arg name="tracking_ground_z" default="0.0" />
  <arg name="tracking_target_center_height" default="0.7" />
  <arg name="tracking_image_topic" default="/camera0/color/image/compressed" />
  <arg name="tracking_odom_topic" default="/unity_odom" />
  <arg name="tracking_device" default="cpu" />
  <arg name="tracking_target_label" default="car" />
  <arg name="tracking_confidence" default="0.6" />
  <arg name="tracking_camera_config" default="$(find general_planner_release)/../tracking_detector/config/camera_unity_main_scene.yaml" />
  <arg name="tracking_estimator_config" default="$(find general_planner_release)/../tracking_detector/config/estimator.yaml" />
  <arg name="tracking_target_odom_topic" default="/target_ekf_node/target_odom" />
  <arg name="tracking_target_prediction_topic" default="/tracking/target_prediction" />
  <!-- Full Unity + deployed release-runtime stack.  This is intentionally a
       separate entry point: unity_planner_sim.launch remains the source-tree
       planner test path.  Marsim is forcibly disabled here; Unity is the
       sole odometry, point-cloud, and command-execution endpoint. -->
  <arg name="rviz" default="true" />
  <arg name="auto_rviz_switch" default="true" />
  <arg name="traj_server" default="true" />
  <arg name="initial_mode" default="state2state" />
  <arg name="exploration_mission_mode" default="target" />
  <arg name="enable_exploration" default="true" />
  <arg name="gate_status_topic" default="/planner/gate/status" />
  <arg name="tcp_port" default="10000" />
  <arg name="init_x" default="0.0" />
  <arg name="init_y" default="0.0" />
  <arg name="init_z" default="1.5" />

  <!-- These defaults deliberately point only at release-owned YAML files. -->
  <arg name="navigation_config"
       default="$(find general_planner_release)/config/task_planner_runtime_state2state.yaml" />
  <arg name="exploration_config"
       default="$(find general_planner_release)/config/exploration_house.yaml" />
  <arg name="target_exploration_config"
       default="$(find general_planner_release)/config/target_exploration.yaml" />
  <arg name="exploration_overlay_config"
       default="$(find general_planner_release)/config/exploration_unity_overlay.yaml" />
  <arg name="rog_map_config"
       default="$(find general_planner_release)/config/exploration_rog_map.yaml" />
  <arg name="global_topology_config"
       default="$(find general_planner_release)/config/global_topology.yaml" />

  <include file="$(find unity_planner_bridge)/launch/unity_endpoint.launch">
    <arg name="tcp_port" value="$(arg tcp_port)" />
    <arg name="init_x" value="$(arg init_x)" />
    <arg name="init_y" value="$(arg init_y)" />
    <arg name="init_z" value="$(arg init_z)" />
  </include>

  <include file="$(find general_planner_release)/launch/planner_runtime.launch">
    <arg name="gate_config" value="$(arg gate_config)" />
    <arg name="gate_overlay_config" value="$(arg gate_overlay_config)" />
    <arg name="perceptor" value="$(arg perceptor)" />
    <arg name="perceptor_config" value="$(arg perceptor_config)" />
    <arg name="perceptor_vlm" value="$(arg perceptor_vlm)" />
    <arg name="perceptor_frame_id" value="$(arg perceptor_frame_id)" />
    <arg name="perceptor_image_topic" value="$(arg perceptor_image_topic)" />
    <arg name="perceptor_camera_info_topic" value="$(arg perceptor_camera_info_topic)" />
    <arg name="perceptor_vlm_model" value="$(arg perceptor_vlm_model)" />
    <arg name="perceptor_vlm_timeout" value="$(arg perceptor_vlm_timeout)" />
    <arg name="perceptor_vlm_period" value="$(arg perceptor_vlm_period)" />
    <arg name="perceptor_vlm_base_url" value="$(arg perceptor_vlm_base_url)" />
    <arg name="tracking_detector" value="$(arg tracking_detector)" />
    <arg name="tracking_camera_info_topic" value="$(arg tracking_camera_info_topic)" />
    <arg name="tracking_rgb_compressed" value="$(arg tracking_rgb_compressed)" />
    <arg name="tracking_depth_topic" value="$(arg tracking_depth_topic)" />
    <arg name="tracking_range_method" value="$(arg tracking_range_method)" />
    <arg name="tracking_depth_registered" value="$(arg tracking_depth_registered)" />
    <arg name="tracking_ground_z" value="$(arg tracking_ground_z)" />
    <arg name="tracking_target_center_height" value="$(arg tracking_target_center_height)" />
    <arg name="tracking_image_topic" value="$(arg tracking_image_topic)" />
    <arg name="tracking_odom_topic" value="$(arg tracking_odom_topic)" />
    <arg name="tracking_device" value="$(arg tracking_device)" />
    <arg name="tracking_target_label" value="$(arg tracking_target_label)" />
    <arg name="tracking_confidence" value="$(arg tracking_confidence)" />
    <arg name="tracking_camera_config" value="$(arg tracking_camera_config)" />
    <arg name="tracking_estimator_config" value="$(arg tracking_estimator_config)" />
    <arg name="tracking_target_odom_topic" value="$(arg tracking_target_odom_topic)" />
    <arg name="tracking_target_prediction_topic" value="$(arg tracking_target_prediction_topic)" />
    <!-- Do not expose this as an outer argument: this Unity entry point must
         never instantiate perfect_drone_sim. -->
    <arg name="marsim" value="false" />
    <arg name="rviz" value="$(arg rviz)" />
    <arg name="auto_rviz_switch" value="$(arg auto_rviz_switch)" />
    <arg name="traj_server" value="$(arg traj_server)" />
    <arg name="initial_mode" value="$(arg initial_mode)" />
    <arg name="exploration_mission_mode" value="$(arg exploration_mission_mode)" />
    <arg name="enable_exploration" value="$(arg enable_exploration)" />
    <arg name="gate_status_topic" value="$(arg gate_status_topic)" />
    <arg name="navigation_config" value="$(arg navigation_config)" />
    <arg name="exploration_config" value="$(arg exploration_config)" />
    <arg name="target_exploration_config" value="$(arg target_exploration_config)" />
    <arg name="exploration_overlay_config" value="$(arg exploration_overlay_config)" />
    <arg name="rog_map_config" value="$(arg rog_map_config)" />
    <arg name="global_topology_config" value="$(arg global_topology_config)" />
    <arg name="cloud_odom_mode" value="latest_odom" />
    <!-- Measured feedback, not the command odometry sent to Unity. -->
    <arg name="odom_topic" value="/lidar_slam/odom" />
    <arg name="cloud_topic" value="/cloud_registered" />
  </include>
</launch>
