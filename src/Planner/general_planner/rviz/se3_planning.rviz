Panels:
  - Class: rviz/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Gate Planner1
      Splitter Ratio: 0.5
    Tree Height: 406
  - Class: rviz/Tool Properties
    Expanded:
      - /2D Nav Goal1
    Name: Tool Properties
    Splitter Ratio: 0.5886790156364441
Preferences:
  PromptSaveOnExit: true
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 1
      Cell Size: 1
      Class: rviz/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Alpha: 1
      Class: rviz/Axes
      Enabled: true
      Length: 1
      Name: Axes
      Radius: 0.05000000074505806
      Reference Frame: <Fixed Frame>
      Show Trail: false
      Value: true
    - Class: rviz/Group
      Displays:
        - Class: rviz/MarkerArray
          Enabled: true
          Marker Topic: /polygon_hole_step_viz/step_markers
          Name: Hole Step Markers
          Namespaces:
            {}
          Queue Size: 10
          Value: true
        - Alpha: 1
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 10
            Min Value: -10
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz/PointCloud2
          Color: 255; 160; 0
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: true
          Invert Rainbow: false
          Max Color: 255; 255; 255
          Min Color: 0; 0; 0
          Name: Hole Polygon Cloud
          Position Transformer: XYZ
          Queue Size: 10
          Selectable: true
          Size (Pixels): 4
          Size (m): 0.03999999910593033
          Style: Spheres
          Topic: /polygon_hole_step_viz/hole_polygon_cloud
          Unreliable: false
          Use Fixed Frame: true
          Use rainbow: true
          Value: true
        - Class: rviz/Marker
          Enabled: true
          Marker Topic: /gate_planner/gate
          Name: Gate
          Namespaces:
            gate: true
          Queue Size: 10
          Value: true
        - Class: rviz/Marker
          Enabled: true
          Marker Topic: /gate_planner/map_box
          Name: MapBox
          Namespaces:
            map_box: true
          Queue Size: 10
          Value: true
        - Class: rviz/MarkerArray
          Enabled: true
          Marker Topic: /gate_planner/corridor
          Name: Corridor
          Namespaces:
            corridor: true
          Queue Size: 10
          Value: true
        - Class: rviz/Marker
          Enabled: true
          Marker Topic: /gate_planner/start_goal
          Name: StartGoal
          Namespaces:
            start_goal: true
          Queue Size: 10
          Value: true
        - Class: rviz/Marker
          Enabled: true
          Marker Topic: /gate_planner/trajectory_marker
          Name: TrajectoryMarker
          Namespaces:
            trajectory: true
          Queue Size: 10
          Value: true
        - Alpha: 1
          Buffer Length: 1
          Class: rviz/Path
          Color: 25; 90; 255
          Enabled: true
          Head Diameter: 0.11999999731779099
          Head Length: 0.20000000298023224
          Length: 0.30000001192092896
          Line Style: Lines
          Line Width: 0.03999999910593033
          Name: TrajectoryPath
          Offset:
            X: 0
            Y: 0
            Z: 0
          Pose Color: 255; 85; 255
          Pose Style: None
          Queue Size: 10
          Radius: 0.029999999329447746
          Shaft Diameter: 0.05999999865889549
          Shaft Length: 0.20000000298023224
          Topic: /gate_planner/trajectory_path
          Unreliable: false
          Value: true
        - Class: rviz/Marker
          Enabled: true
          Marker Topic: /gate_planner/vehicle
          Name: VehicleReplay
          Namespaces:
            vehicle_ellipsoid: true
          Queue Size: 10
          Value: true
        - Class: rviz/MarkerArray
          Enabled: true
          Marker Topic: /gate_planner/vehicle_ellipsoids
          Name: VehicleTrajectoryEllipsoids
          Namespaces:
            vehicle_ellipsoids: true
          Queue Size: 10
          Value: true
      Enabled: true
      Name: Gate Planner
  Enabled: true
  Global Options:
    Background Color: 235; 235; 235
    Default Light: true
    Fixed Frame: odom
    Frame Rate: 60
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetInitialPose
      Theta std deviation: 0.2617993950843811
      Topic: /initialpose
      X std deviation: 0.5
      Y std deviation: 0.5
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
    - Class: rviz/PublishPoint
      Single click: true
      Topic: /clicked_point
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 11.01463508605957
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Field of View: 0.7853981852531433
      Focal Point:
        X: 0
        Y: 0
        Z: 1.2000000476837158
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05000000074505806
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: 0.39000025391578674
      Target Frame: <Fixed Frame>
      Yaw: 1.579999327659607
    Saved: ~
Window Geometry:
  Displays:
    collapsed: true
  Height: 1371
  Hide Left Dock: true
  Hide Right Dock: true
  QMainWindow State: 
  Tool Properties:
    collapsed: true
  Width: 2494
  X: 66
  Y: 32
