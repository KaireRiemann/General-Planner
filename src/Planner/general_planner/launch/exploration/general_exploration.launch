<launch>
  <arg name="planner_config" default="$(find general_planner)/config/exploration.yaml" />
  <arg name="map_config" default="$(find general_planner)/config/map.yaml" />
  <arg name="odom_topic" default="/lidar_slam/odom" />
  <arg name="cloud_topic" default="/cloud_registered" />
  <arg name="trigger_topic" default="/move_base_simple/goal" />
  <arg name="rviz" default="true" />
  <arg name="traj_server" default="true" />
  <arg name="task_control_enable" default="true" />

  <include file="$(find general_planner)/launch/exploration/algorithm.xml">
    <arg name="planner_config" value="$(arg planner_config)" />
    <arg name="map_config" value="$(arg map_config)" />
    <arg name="odom_topic" value="$(arg odom_topic)" />
    <arg name="cloud_topic" value="$(arg cloud_topic)" />
    <arg name="trigger_topic" value="$(arg trigger_topic)" />
    <arg name="task_control_enable" value="$(arg task_control_enable)" />
  </include>

  <node if="$(arg traj_server)" pkg="general_planner" name="traj_server"
        type="highspeed_traj_server" output="screen" clear_params="true">
    <rosparam file="$(arg planner_config)" command="load" />
    <param name="require_task_binding" value="false" type="bool" />
    <param name="odometry_topic" value="$(arg odom_topic)" type="string" />
    <param name="execution_enabled_topic"
           value="/planning/exploration/command_enabled" type="string" />
  </node>

  <include if="$(arg rviz)" file="$(find general_planner)/launch/exploration/rviz.launch" />
</launch>
