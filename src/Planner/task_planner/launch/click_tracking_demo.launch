<launch>
    <arg name="target_sim_config" default="click.yaml"/>
    <arg name="target_planner_config" default="click_smooth_ros1.yaml"/>
    <arg name="tracker_sim_config" default="swarm_drone1.yaml"/>
    <arg name="tracker_planner_config" default="tracking_tracker_drone1_ros1.yaml"/>
    <arg name="rviz" default="true"/>
    <arg name="fpv_rviz" default="true"/>
    <arg name="monitor" default="true"/>
    <arg name="rviz_config" default="$(find general_planner)/rviz/click_tracking.rviz"/>
    <arg name="fpv_rviz_config" default="$(find general_planner)/rviz/click_tracking_fpv.rviz"/>

    <include file="$(find task_planner)/launch/click_demo.launch">
        <arg name="sim_config" value="$(arg target_sim_config)"/>
        <arg name="planner_config" value="$(arg target_planner_config)"/>
        <arg name="rviz" value="false"/>
        <arg name="fpv_rviz" value="false"/>
    </include>

    <group ns="drone_1">
        <node pkg="perfect_drone_sim" type="perfect_drone"
              name="perfect_drone" output="log" clear_params="true">
            <param name="config_name" value="$(arg tracker_sim_config)" type="string"/>
        </node>

        <node pkg="general_planner" type="fsm_node" name="fsm_node" output="screen" clear_params="true">
            <param name="config_name" value="$(arg tracker_planner_config)" type="string"/>
        </node>
    </group>

    <node pkg="general_planner" type="tracking_target_relay" name="tracking_target_relay" output="screen">
        <param name="target_odom_topic" value="/lidar_slam/odom" type="string"/>
        <param name="target_traj_topic" value="/planning_cmd/poly_traj" type="string"/>
        <param name="tracking_target_odom_topic" value="/tracking/target_odom" type="string"/>
        <param name="tracking_prediction_topic" value="/tracking/target_prediction" type="string"/>
        <param name="tracking_target_path_topic" value="/tracking/target_path" type="string"/>
        <param name="prediction_horizon" value="4.0" type="double"/>
        <param name="prediction_dt" value="0.25" type="double"/>
        <param name="path_dt" value="0.1" type="double"/>
        <param name="publish_rate" value="30.0" type="double"/>
        <param name="publish_before_trajectory" value="false" type="bool"/>
    </node>

    <node if="$(arg monitor)" pkg="general_planner" type="tracking_sim_monitor"
          name="tracking_sim_monitor" output="screen">
        <param name="drone_odom_topic" value="/drone_1/lidar_slam/odom" type="string"/>
        <param name="target_odom_topic" value="/tracking/target_odom" type="string"/>
        <param name="desired_distance" value="2.2" type="double"/>
        <param name="height_offset" value="0.7" type="double"/>
        <param name="warmup_time" value="3.0" type="double"/>
        <param name="sample_rate" value="20.0" type="double"/>
    </node>

    <node if="$(arg rviz)" pkg="rviz" type="rviz" name="click_tracking_rviz"
          args="-d $(arg rviz_config)" output="log"/>
    <node if="$(arg fpv_rviz)" pkg="rviz" type="rviz" name="click_tracking_fpv"
          args="-d $(arg fpv_rviz_config)" output="log"/>
</launch>
