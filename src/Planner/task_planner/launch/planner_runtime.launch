<launch>
  <!-- M2 composed runtime. planner_runtime_node owns exactly one ROG map,
       MapManager, BoundaryMap and global topology worker.  Exploration and
       state2state are in-process adapters; switching modes never kills a
       planner or recreates a map. -->
  <arg name="marsim" default="true" />
  <arg name="rviz" default="true" />
  <arg name="auto_rviz_switch" default="true" />
  <arg name="traj_server" default="true" />
  <!-- Empty in normal operation.  Kept as a launch-level diagnostic hook so
       a crash can be reproduced under gdb without changing the node command. -->
  <arg name="planner_runtime_launch_prefix" default="" />
  <!-- Runtime modes: hold, state2state, exploration (legacy coverage),
       target_exploration, or gate. Gate keeps the world map/topology alive
       while yielding /planning/pos_cmd to an external slit/gate planner. -->
  <arg name="initial_mode" default="target_exploration" />
  <arg name="exploration_mission_mode" default="target" />
  <!-- HighSpeedExp needs a finite internal index capacity, but destination
       tasks must not require a hand-measured scene box.  In target mode this
       bootstraps that capacity from the first odometry pose; set false only
       for a legacy coverage mission that intentionally uses its YAML boxes. -->
  <arg name="target_exploration_auto_workspace"
       default="$(eval 'true' if arg('initial_mode') == 'target_exploration' else 'false')" />
  <arg name="target_exploration_workspace_half_extent_xy" default="120.0" />
  <arg name="target_exploration_workspace_below_odom" default="2.0" />
  <arg name="target_exploration_workspace_above_odom" default="5.0" />
  <arg name="enable_exploration" default="true" />
  <!-- std_msgs/String protocol from the external gate planner:
       START (BEGIN/RUNNING accepted) and END (DONE/FINISHED accepted). -->
  <arg name="gate_status_topic" default="/planner/gate/status" />

  <arg name="sim_config"
       default="$(find general_planner)/config/exploration_sim.yaml" />
  <arg name="navigation_config"
       default="$(find general_planner)/config/task_planner_runtime_state2state.yaml" />
  <arg name="exploration_config"
       default="$(find general_planner)/config/exploration_house.yaml" />
  <!-- Target-task policy is separate from map/sensor/base exploration
       settings. It is loaded after the base profile and before an optional
       scene overlay, so an arena may tune only its height/progress deltas. -->
  <arg name="target_exploration_config"
       default="$(find general_planner)/config/target_exploration.yaml" />
  <!-- Optional arena-specific overrides, applied after the base exploration
       profile.  This keeps the runtime wiring identical while allowing a
       simulator PCD to supply its own bounds and sensor model. -->
  <arg name="exploration_overlay_config" default="" />
  <!-- Must keep rog_map/ros_callback/enable=false: GlobalMapRuntime is the
       only cloud/odom fusion owner. -->
  <arg name="rog_map_config"
       default="$(find general_planner)/config/exploration_rog_map.yaml" />
  <arg name="global_topology_config"
       default="$(find general_planner)/config/global_topology.yaml" />

  <arg name="rviz_config"
       default="$(find general_planner)/rviz/planner_runtime_exploration.rviz" />
  <arg name="exploration_rviz_config"
       default="$(find general_planner)/rviz/planner_runtime_exploration.rviz" />
  <arg name="state2state_rviz_config"
       default="$(find general_planner)/rviz/planner_runtime_state2state.rviz" />
  <arg name="odom_topic" default="/lidar_slam/odom" />
  <arg name="cloud_topic" default="/cloud_registered" />

  <arg name="fsm_replan_time" default="0.25" />
  <arg name="fsm_replan_time_after_traj_start" default="0.35" />
  <arg name="fsm_replan_time_before_traj_end" default="1.0" />
  <arg name="global_path_update_min_interval" default="0.2" />
  <arg name="cloud_subscriber_queue" default="1" />
  <arg name="odom_subscriber_queue" default="50" />
  <arg name="sync_queue" default="20" />
  <arg name="cloud_odom_mode" default="approximate_sync" />
  <arg name="latest_odom_timeout" default="0.5" />
  <arg name="max_cloud_age" default="0.5" />
  <arg name="heartbeat_timeout" default="1.5" />
  <arg name="task_control_enable" default="true" />
  <arg name="coverage_guidance_mode"
       default="$(eval 'off' if arg('initial_mode') == 'target_exploration' else 'full')" />
  <arg name="original_frontend_compatibility" default="true" />
  <arg name="use_lkh" default="true" />
  <arg name="tsp_dir" default="/tmp" />
  <arg name="rog_map_enable" default="true" />
  <arg name="bubble_astar_allocate_num" default="1000000" />
  <arg name="bubble_astar_lambda_heu" default="100.0" />
  <arg name="bubble_astar_resolution" default="0.25" />
  <arg name="bubble_topo_cube_discrete_size" default="0.30" />
  <arg name="view_graph" default="false" />
  <arg name="view_frontier" default="true" />
  <arg name="view_cluster" default="true" />

  <node if="$(arg marsim)" pkg="perfect_drone_sim" type="perfect_drone"
        name="perfect_drone" output="screen" clear_params="true">
    <param name="config_path" value="$(arg sim_config)" type="string" />
  </node>

  <!-- Trajectory execution has no map ownership; it remains a separate
       process and publishes only the exploration source topic. -->
  <node if="$(arg traj_server)" pkg="general_planner" type="highspeed_traj_server"
        name="highspeed_traj_server" output="screen">
    <param name="odometry_topic" value="$(arg odom_topic)" type="string" />
    <param name="replan_time" value="$(arg fsm_replan_time)" type="double" />
    <param name="heartbeat_timeout" value="$(arg heartbeat_timeout)" type="double" />
    <param name="pos_cmd_topic" value="/planning/exploration/pos_cmd" type="string" />
    <param name="execution_enabled_topic"
           value="/planning/exploration/command_enabled" type="string" />
  </node>

  <node pkg="general_planner" type="planner_runtime_node" name="planner_runtime_node"
        output="screen" clear_params="true"
        launch-prefix="$(arg planner_runtime_launch_prefix)">
    <rosparam file="$(arg exploration_config)" command="load" />
    <rosparam file="$(arg target_exploration_config)" command="load" />
    <rosparam if="$(eval arg('exploration_overlay_config') != '')"
              file="$(arg exploration_overlay_config)" command="load" />
    <rosparam file="$(arg global_topology_config)" command="load" />

    <param name="initial_mode" value="$(arg initial_mode)" type="string" />
    <!-- Keep the standalone exploration adapter aligned at boot. Runtime mode
         switches still issue MODE target/coverage before accepting a task. -->
    <param name="exploration/mission_mode"
           value="$(arg exploration_mission_mode)" type="string" />
    <param name="target_exploration/auto_workspace/enabled"
           value="$(arg target_exploration_auto_workspace)" type="bool" />
    <param name="target_exploration/auto_workspace/half_extent_xy"
           value="$(arg target_exploration_workspace_half_extent_xy)" type="double" />
    <param name="target_exploration/auto_workspace/below_odom"
           value="$(arg target_exploration_workspace_below_odom)" type="double" />
    <param name="target_exploration/auto_workspace/above_odom"
           value="$(arg target_exploration_workspace_above_odom)" type="double" />
    <param name="navigation_enabled" value="true" type="bool" />
    <param name="exploration_enabled" value="$(arg enable_exploration)" type="bool" />
    <param name="serial_handover" value="false" type="bool" />
    <!-- Gate requires the composed runtime gateway. Do not set
         serial_handover=true: a separately launched fsm_node would otherwise
         be another uncontrolled writer on /planning/pos_cmd. -->
    <param name="gate_status_topic" value="$(arg gate_status_topic)" type="string" />
    <param name="global_map_config" value="$(arg rog_map_config)" type="string" />
    <param name="navigation_config" value="$(arg navigation_config)" type="string" />
    <param name="odometry_topic" value="$(arg odom_topic)" type="string" />
    <param name="cloud_topic" value="$(arg cloud_topic)" type="string" />
    <param name="RogMapEnable" value="$(arg rog_map_enable)" type="bool" />
    <param name="RogMapConfigPath" value="$(arg rog_map_config)" type="string" />
    <param name="navigation_cmd_topic" value="/planning/navigation/pos_cmd" type="string" />
    <param name="exploration_cmd_topic" value="/planning/exploration/pos_cmd" type="string" />
    <param name="output_cmd_topic" value="/planning/pos_cmd" type="string" />
    <param name="exploration_command_topic" value="/planning/exploration/command" type="string" />
    <param name="exploration_task_request_topic" value="/planning/exploration/task_request" type="string" />
    <param name="exploration_status_topic" value="/planning/exploration/status" type="string" />
    <param name="navigation_command_topic" value="/planning/navigation/command" type="string" />
    <param name="navigation_status_topic" value="/planning/navigation/status" type="string" />
    <param name="navigation_task_mode_topic" value="/planning/navigation_task_mode" type="string" />
    <param name="navigation_goal_out_topic" value="/planning/click_goal" type="string" />
    <!-- External 3D RViz goals pass through PlannerSupervisor before the FSM.
         The internal topic is distinct to prevent a direct bypass/feedback loop. -->
    <param name="navigation_goal_3d_in_topic" value="/goal_3d" type="string" />
    <param name="navigation_goal_3d_out_topic" value="/planning/click_goal_3d" type="string" />
    <param name="click_demo_goal_topic" value="/goal" type="string" />
    <param name="hover_speed_threshold" value="0.10" type="double" />
    <param name="hover_yaw_rate_threshold" value="0.10" type="double" />
    <param name="hover_hold_duration" value="0.50" type="double" />
    <param name="max_odom_age" value="0.20" type="double" />

    <!-- Exploration adapter configuration.  It owns only LIO/Bubble/frontier
         task state; cloud/odom subscriptions are disabled by composition. -->
    <param name="view_graph" value="$(arg view_graph)" type="bool" />
    <param name="FrontierManager/view_frt" value="$(arg view_frontier)" type="bool" />
    <param name="FrontierManager/view_cluster" value="$(arg view_cluster)" type="bool" />
    <param name="fsm/thresh_replan" value="0.5" type="double" />
    <param name="fsm/emergency_replan_control_error" value="1.5" type="double" />
    <param name="fsm/replan_time" value="$(arg fsm_replan_time)" type="double" />
    <param name="fsm/replan_time_after_traj_start" value="$(arg fsm_replan_time_after_traj_start)" type="double" />
    <param name="fsm/replan_time_before_traj_end" value="$(arg fsm_replan_time_before_traj_end)" type="double" />
    <param name="fsm/debug_planner" value="false" type="bool" />
    <param name="fsm/auto_trigger" value="false" type="bool" />
    <param name="fsm/global_path_update_min_interval" value="$(arg global_path_update_min_interval)" type="double" />
    <param name="fsm/cloud_subscriber_queue" value="$(arg cloud_subscriber_queue)" type="int" />
    <param name="fsm/odom_subscriber_queue" value="$(arg odom_subscriber_queue)" type="int" />
    <param name="fsm/sync_queue" value="$(arg sync_queue)" type="int" />
    <param name="fsm/cloud_odom_mode" value="$(arg cloud_odom_mode)" type="string" />
    <param name="fsm/latest_odom_timeout" value="$(arg latest_odom_timeout)" type="double" />
    <param name="fsm/max_cloud_age" value="$(arg max_cloud_age)" type="double" />
    <param name="fsm/task_control_enable" value="$(arg task_control_enable)" type="bool" />
    <param name="fsm/task_command_topic" value="/planning/exploration/command" type="string" />
    <param name="fsm/task_request_topic" value="/planning/exploration/task_request" type="string" />
    <param name="fsm/task_status_topic" value="/planning/exploration/status" type="string" />
    <param name="fsm/execution_enabled_topic" value="/planning/exploration/command_enabled" type="string" />
    <param name="fsm/trigger_topic" value="" type="string" />
    <param name="fsm/target_goal_topic" value="/planning/exploration/target_goal" type="string" />
    <param name="fsm/legacy_trigger_topic" value="" type="string" />
    <param name="fsm/handover_slow_speed" value="0.10" type="double" />
    <param name="coverage_guidance/mode" value="$(arg coverage_guidance_mode)" type="string" />
    <param name="exploration/original_frontend_compatibility" value="$(arg original_frontend_compatibility)" type="bool" />
    <param name="exploration/use_lkh" value="$(arg use_lkh)" type="bool" />
    <param name="exploration/tsp_dir" value="$(arg tsp_dir)" type="string" />
    <param name="bubble_astar/allocate_num" value="$(arg bubble_astar_allocate_num)" type="int" />
    <param name="bubble_astar/lambda_heu" value="$(arg bubble_astar_lambda_heu)" type="double" />
    <param name="bubble_astar/debug" value="false" type="bool" />
    <param name="bubble_astar/resolution_astar" value="$(arg bubble_astar_resolution)" type="double" />
    <param name="bubble_topo/cube_discrete_size" value="$(arg bubble_topo_cube_discrete_size)" type="double" />
  </node>

  <group if="$(arg rviz)">
    <node unless="$(arg auto_rviz_switch)" pkg="rviz" type="rviz"
          name="rvizvisualisation" output="log"
          args="-d $(arg rviz_config)" />
    <node if="$(arg auto_rviz_switch)" pkg="general_planner"
          type="planner_rviz_switcher.py" name="planner_rviz_switcher"
          output="screen">
      <param name="rviz_node_name" value="rvizvisualisation" type="string" />
      <param name="exploration_rviz_config" value="$(arg exploration_rviz_config)" type="string" />
      <param name="state2state_rviz_config" value="$(arg state2state_rviz_config)" type="string" />
      <param name="hold_rviz_config" value="$(arg exploration_rviz_config)" type="string" />
      <param name="initial_mode" value="$(arg initial_mode)" type="string" />
      <param name="status_topic" value="/planner/status" type="string" />
    </node>
    <node pkg="tf" type="static_transform_publisher" name="exploration_world_tf"
          args="0 0 0 0 0 0 world navigation 100" />
  </group>
</launch>
