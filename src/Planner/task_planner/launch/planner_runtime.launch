<launch>
  <!-- Single exploration profile entry. Algorithm tuning comes exclusively from
       exploration_config; map_config owns the shared map. The same profile is
       loaded in the trajectory server namespace for replan_time/heartbeat_timeout.
       Topics and command ownership below are composition wiring, not tuning.
       Start in HOLD; request exploration and trigger after mode readiness. -->
  <arg name="tracking_detector" default="true" />
  <arg name="tracking_camera_info_topic" default="/camera0/color/info" />
  <arg name="tracking_rgb_compressed" default="true" />
  <arg name="tracking_depth_topic" default="/camera0/depth/image/compressed" />
  <arg name="tracking_range_method" default="auto" />
  <arg name="tracking_depth_registered" default="false" />
  <arg name="tracking_ground_z" default="0.0" />
  <arg name="tracking_target_center_height" default="0.7" />
  <arg name="tracking_image_topic" default="/camera0/color/image/compressed" />
  <arg name="tracking_odom_topic" default="/unity_odom" />
  <arg name="tracking_device" default="cpu" />
  <arg name="tracking_target_label" default="car" />
  <arg name="tracking_confidence" default="0.6" />
  <arg name="tracking_camera_config" default="$(find tracking_detector)/config/camera.yaml" />
  <arg name="tracking_estimator_config" default="$(find tracking_detector)/config/estimator.yaml" />
  <arg name="perceptor_config" default="$(find aperture_detector)/config/polygon_hole_step_viz_unity_sim.yaml" />
  <arg name="gate_overlay_config" default="" />
  <arg name="perceptor" default="true" />
  <arg name="perceptor_vlm" default="true" />
  <arg name="perceptor_frame_id" default="world" />
  <arg name="perceptor_image_topic" default="/camera0/color/image/compressed" />
  <arg name="perceptor_camera_info_topic" default="/camera0/color/info" />
  <arg name="perceptor_vlm_model" default="auto" />
  <arg name="perceptor_vlm_timeout" default="10.0" />
  <arg name="perceptor_vlm_period" default="3.0" />
  <arg name="perceptor_vlm_base_url" default="http://127.0.0.1:18000/v1" />
  <arg name="marsim" default="false" />
  <arg name="rviz" default="true" />
  <arg name="auto_rviz_switch" default="true" />
  <arg name="traj_server" default="true" />
  <arg name="planner_runtime_launch_prefix" default="" />
  <arg name="gate_config" default="$(find general_planner)/config/gate_runtime.yaml" />
  <arg name="initial_mode" default="hold" />
  <arg name="source_startup_grace_duration" default="2.0" />
  <arg name="enable_exploration" default="true" />
  <arg name="gate_status_topic" default="/planner/gate/status" />
  <arg name="sim_config" default="$(find general_planner)/config/exploration_sim.yaml" />
  <arg name="tracking_config" default="$(find general_planner)/config/task_planner_runtime_tracking.yaml" />
  <arg name="navigation_config" default="$(find general_planner)/config/task_planner_runtime_state2state.yaml" />
  <arg name="exploration_config" default="$(find general_planner)/config/exploration.yaml" />
  <arg name="map_config" default="$(find general_planner)/config/map.yaml" />
  <arg name="rviz_config" default="$(find general_planner)/rviz/planner_runtime_exploration.rviz" />
  <arg name="exploration_rviz_config" default="$(find general_planner)/rviz/planner_runtime_exploration.rviz" />
  <arg name="state2state_rviz_config" default="$(find general_planner)/rviz/planner_runtime_state2state.rviz" />
  <arg name="tracking_target_odom_topic" default="/tracking/target_odom" />
  <arg name="tracking_target_prediction_topic" default="/tracking/target_prediction" />
  <arg name="odom_topic" default="/ekf/ekf_odom" />
  <arg name="cloud_topic" default="/laserMapping/cloud_registered" />
  <arg name="map_cloud_topic" default="/mapping/cloud_without_target" />
  <arg name="tracking_dynamic_points_topic" default="/tracking/dynamic_points" />
  <arg name="filter_mapping_cloud" default="true" />
  <arg name="task_control_enable" default="true" />
  <arg name="rog_map_enable" default="true" />
  <node if="$(arg marsim)" pkg="perfect_drone_sim" type="perfect_drone" name="perfect_drone" output="screen" clear_params="true">
    <param name="config_path" value="$(arg sim_config)" type="string" />
  </node>
  <node if="$(arg traj_server)" pkg="general_planner" type="highspeed_traj_server" name="highspeed_traj_server" output="screen">
    <rosparam file="$(arg exploration_config)" command="load" />
    <param name="odometry_topic" value="$(arg odom_topic)" type="string" />
    <param name="require_task_binding" value="true" type="bool" />
    <param name="pos_cmd_topic" value="/planning/exploration/pos_cmd" type="string" />
    <param name="execution_enabled_topic" value="/planning/exploration/command_enabled" type="string" />
  </node>
  <node if="$(arg filter_mapping_cloud)" pkg="tracking_detector" type="target_cloud_filter" name="target_cloud_filter" output="screen" clear_params="true">
    <param name="frontend_voxel_resolution" value="0.10" />
    <param name="cluster_wait_seconds" value="0.50" />
    <param name="cluster_hold_seconds" value="1.00" />
    <remap from="~cloud_in" to="$(arg cloud_topic)" />
    <remap from="~target_cluster" to="$(arg tracking_dynamic_points_topic)" />
    <remap from="~cloud_out" to="$(arg map_cloud_topic)" />
  </node>
  <node pkg="general_planner" type="planner_runtime_node" name="planner_runtime_node" output="screen" clear_params="true" launch-prefix="$(arg planner_runtime_launch_prefix)">
    <rosparam file="$(arg exploration_config)" command="load" />
    <rosparam file="$(arg gate_config)" command="load" />
    <rosparam if="$(eval arg('gate_overlay_config') != '')" file="$(arg gate_overlay_config)" command="load" />
    <rosparam file="$(arg map_config)" command="load" />
    <param name="initial_mode" value="$(arg initial_mode)" type="string" />
    <param name="source_startup_grace_duration" value="$(arg source_startup_grace_duration)" type="double" />
    <param name="navigation_enabled" value="true" type="bool" />
    <param name="exploration_enabled" value="$(arg enable_exploration)" type="bool" />
    <param name="serial_handover" value="false" type="bool" />
    <param name="gate_status_topic" value="$(arg gate_status_topic)" type="string" />
    <param name="map_config" value="$(arg map_config)" type="string" />
    <param name="tracking_target_odom_topic" value="$(arg tracking_target_odom_topic)" />
    <param name="tracking_target_prediction_topic" value="$(arg tracking_target_prediction_topic)" />
    <param name="navigation_config" value="$(arg navigation_config)" type="string" />
    <param name="tracking_config" value="$(arg tracking_config)" type="string" />
    <param name="odometry_topic" value="$(arg odom_topic)" type="string" />
    <param name="cloud_topic" value="$(eval arg('map_cloud_topic') if arg('filter_mapping_cloud') else arg('cloud_topic'))" type="string" />
    <param name="RogMapEnable" value="$(arg rog_map_enable)" type="bool" />
    <param name="RogMapConfigPath" value="$(arg map_config)" type="string" />
    <param name="navigation_cmd_topic" value="/planning/navigation/pos_cmd" type="string" />
    <param name="exploration_cmd_topic" value="/planning/exploration/pos_cmd" type="string" />
    <param name="output_cmd_topic" value="/planning/pos_cmd" type="string" />
    <param name="exploration_command_topic" value="/planning/exploration/command" type="string" />
    <param name="exploration_task_request_topic" value="/planning/exploration/task_request" type="string" />
    <param name="exploration_status_topic" value="/planning/exploration/status" type="string" />
    <param name="navigation_command_topic" value="/planning/navigation/command" type="string" />
    <param name="navigation_status_topic" value="/planning/navigation/status" type="string" />
    <param name="navigation_task_mode_topic" value="/planning/navigation_task_mode" type="string" />
    <param name="navigation_goal_out_topic" value="/planning/click_goal" type="string" />
    <param name="navigation_goal_3d_in_topic" value="/goal_3d" type="string" />
    <param name="navigation_goal_3d_out_topic" value="/planning/click_goal_3d" type="string" />
    <param name="click_demo_goal_topic" value="/goal" type="string" />
    <param name="hover_speed_threshold" value="0.10" type="double" />
    <param name="hover_yaw_rate_threshold" value="0.10" type="double" />
    <param name="hover_hold_duration" value="0.50" type="double" />
    <param name="max_odom_age" value="0.5" type="double" />
    <param name="fsm/task_control_enable" value="$(arg task_control_enable)" type="bool" />
    <param name="fsm/task_command_topic" value="/planning/exploration/command" type="string" />
    <param name="fsm/task_request_topic" value="/planning/exploration/task_request" type="string" />
    <param name="fsm/task_status_topic" value="/planning/exploration/status" type="string" />
    <param name="fsm/execution_enabled_topic" value="/planning/exploration/command_enabled" type="string" />
    <param name="fsm/trigger_topic" value="" type="string" />
    <param name="fsm/legacy_trigger_topic" value="" type="string" />
    <param name="bubble_astar/debug" value="false" type="bool" />
  </node>
  <group if="$(arg rviz)">
    <node unless="$(arg auto_rviz_switch)" pkg="rviz" type="rviz" name="rvizvisualisation" output="log" args="-d $(arg rviz_config)" />
    <node if="$(arg auto_rviz_switch)" pkg="general_planner" type="planner_rviz_switcher.py" name="planner_rviz_switcher" output="screen">
      <param name="rviz_node_name" value="rvizvisualisation" type="string" />
      <param name="exploration_rviz_config" value="$(arg exploration_rviz_config)" type="string" />
      <param name="state2state_rviz_config" value="$(arg state2state_rviz_config)" type="string" />
      <param name="hold_rviz_config" value="$(arg exploration_rviz_config)" type="string" />
      <param name="initial_mode" value="$(arg initial_mode)" type="string" />
      <param name="status_topic" value="/planner/status" type="string" />
    </node>
    <node pkg="tf" type="static_transform_publisher" name="exploration_world_tf" args="0 0 0 0 0 0 world navigation 100" />
  </group>
  <node if="$(arg perceptor)" pkg="general_planner" type="planner_detector_switcher.py" name="gate_detector_switcher" output="screen">
    <param name="active_mode" value="gate" />
    <param name="status_topic" value="/planner/status" />
    <param name="launch_file" value="$(find aperture_detector)/launch/detector.launch" />
    <param name="launch_args/config" value="$(arg perceptor_config)" type="str" />
    <param name="launch_args/cloud_topic" value="$(arg cloud_topic)" type="str" />
    <param name="launch_args/odom_topic" value="$(arg odom_topic)" type="str" />
    <param name="launch_args/frame_id" value="$(arg perceptor_frame_id)" type="str" />
    <param name="launch_args/vlm" value="$(arg perceptor_vlm)" type="str" />
    <param name="launch_args/image_topic" value="$(arg perceptor_image_topic)" type="str" />
    <param name="launch_args/camera_info_topic" value="$(arg perceptor_camera_info_topic)" type="str" />
    <param name="launch_args/vlm_model" value="$(arg perceptor_vlm_model)" type="str" />
    <param name="launch_args/vlm_timeout" value="$(arg perceptor_vlm_timeout)" type="str" />
    <param name="launch_args/vlm_period" value="$(arg perceptor_vlm_period)" type="str" />
    <param name="launch_args/vlm_base_url" value="$(arg perceptor_vlm_base_url)" type="str" />
  </node>
  <node if="$(arg tracking_detector)" pkg="general_planner" type="planner_detector_switcher.py" name="tracking_detector_switcher" output="screen">
    <param name="active_mode" value="tracking" />
    <param name="launch_args/camera_info_topic" value="$(arg tracking_camera_info_topic)" type="str" />
    <param name="launch_args/rgb_compressed" value="$(arg tracking_rgb_compressed)" type="str" />
    <param name="launch_args/depth_topic" value="$(arg tracking_depth_topic)" type="str" />
    <param name="launch_args/range_method" value="$(arg tracking_range_method)" type="str" />
    <param name="launch_args/depth_registered" value="$(arg tracking_depth_registered)" type="str" />
    <param name="launch_args/ground_z" value="$(arg tracking_ground_z)" type="str" />
    <param name="launch_args/target_center_height" value="$(arg tracking_target_center_height)" type="str" />
    <param name="status_topic" value="/planner/status" />
    <param name="launch_file" value="$(find tracking_detector)/launch/tracking_detector.launch" />
    <param name="launch_args/rgb_topic" value="$(arg tracking_image_topic)" type="str" />
    <param name="launch_args/odom_topic" value="$(arg tracking_odom_topic)" type="str" />
    <param name="launch_args/lidar_odom_topic" value="$(arg odom_topic)" type="str" />
    <param name="launch_args/device" value="$(arg tracking_device)" type="str" />
    <param name="launch_args/target_label" value="$(arg tracking_target_label)" type="str" />
    <param name="launch_args/confidence" value="$(arg tracking_confidence)" type="str" />
    <param name="launch_args/camera_config" value="$(arg tracking_camera_config)" type="str" />
    <param name="launch_args/estimator_config" value="$(arg tracking_estimator_config)" type="str" />
    <param name="launch_args/target_odom_topic" value="$(arg tracking_target_odom_topic)" type="str" />
    <param name="launch_args/prediction_topic" value="$(arg tracking_target_prediction_topic)" type="str" />
    <param name="launch_args/start_cloud_filter" value="false" type="str" />
    <param name="launch_args/start_person_tracker" value="true" type="str" />
    <param name="launch_args/start_lidar_cluster" value="false" type="str" />
    <param name="launch_args/start_predictor" value="false" type="str" />
    <param name="launch_args/start_ekf" value="false" type="str" />
    <param name="launch_args/cloud_in_topic" value="$(arg cloud_topic)" type="str" />
    <param name="launch_args/dynamic_points_topic" value="$(arg tracking_dynamic_points_topic)" type="str" />
  </node>
</launch>