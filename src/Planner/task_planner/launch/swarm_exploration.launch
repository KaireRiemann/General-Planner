<launch>
  <!-- Convenience entry point.  The implementation itself remains in the
       general_planner package beside the single-UAV exploration launch. -->
  <arg name="simulation" default="true" />
  <arg name="rviz" default="true" />
  <arg name="auto_start" default="false" />
  <arg name="mission_epoch" default="1" />
  <arg name="trigger_topic" default="/move_base_simple/goal" />
  <arg name="rviz_config"
       default="$(find general_planner)/config/swarm_exploration/swarm_exploration.rviz" />
  <include file="$(find general_planner)/launch/exploration/swarm_house_2uav.launch">
    <arg name="simulation" value="$(arg simulation)" />
    <arg name="rviz" value="$(arg rviz)" />
    <arg name="auto_start" value="$(arg auto_start)" />
    <arg name="mission_epoch" value="$(arg mission_epoch)" />
    <arg name="trigger_topic" value="$(arg trigger_topic)" />
    <arg name="rviz_config" value="$(arg rviz_config)" />
  </include>
</launch>
