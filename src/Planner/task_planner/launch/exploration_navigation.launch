<launch>
  <arg name="marsim" default="true" />
  <arg name="rviz" default="true" />
  <arg name="auto_rviz_switch" default="true" />
  <arg name="traj_server" default="true" />
  <arg name="initial_mode" default="target_exploration" />
  <arg name="sim_config" default="$(find perfect_drone_sim)/config/click.yaml" />
  <arg name="exploration_config" default="$(find general_planner)/config/exploration.yaml" />
  <arg name="map_config" default="$(find general_planner)/config/map.yaml" />
  <include file="$(find task_planner)/launch/planner_runtime.launch">
    <arg name="marsim" value="$(arg marsim)" />
    <arg name="rviz" value="$(arg rviz)" />
    <arg name="auto_rviz_switch" value="$(arg auto_rviz_switch)" />
    <arg name="traj_server" value="$(arg traj_server)" />
    <arg name="initial_mode" value="$(arg initial_mode)" />
    <arg name="sim_config" value="$(arg sim_config)" />
    <arg name="exploration_config" value="$(arg exploration_config)" />
    <arg name="map_config" value="$(arg map_config)" />
    <arg name="odom_topic" value="/lidar_slam/odom" />
    <arg name="cloud_topic" value="/cloud_registered" />
  </include>
</launch>