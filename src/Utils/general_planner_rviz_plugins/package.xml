<?xml version="1.0"?>
<package format="2">
  <name>general_planner_rviz_plugins</name>
  <version>0.1.0</version>
  <description>RViz tools for publishing explicit 3D goals to General-Planner.</description>

  <maintainer email="renyf@connect.hku.hk">Yunfan Ren</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>qtbase5-dev</build_depend>
  <depend>geometry_msgs</depend>
  <depend>pluginlib</depend>
  <depend>roscpp</depend>
  <depend>rviz</depend>

  <export>
    <rviz plugin="${prefix}/plugin_description.xml"/>
  </export>
</package>
