<launch>
    <arg name="waypoint_mission" default="false"/>
    <arg name="rviz" default="true"/>
    <arg name="fpv_rviz" default="true"/>
    <arg name="rviz_config" default="$(find perfect_drone_sim)/rviz/benchmark.rviz"/>

    <node if="$(arg waypoint_mission)" pkg="task_planner" name="waypoint_mission" type="waypoint_mission" output="screen">
            <!--     1. use absolute path -->
            <!--         <param name="config_path" value="" type="string"></param> -->
            <!--     2. use file name in general_planner/config/... -->
                    <param name="data_name" value="benchmark.txt" type="string"></param>
    </node>

        <node pkg="perfect_drone_sim" type="perfect_drone" name="perfect_drone" output="log">
            <!--     1. use absolute path -->
            <!--         <param name="config_path" value="" type="string"></param> -->
            <!--     2. use file name in general_planner/config/... -->
                    <param name="config_name" value="high_speed.yaml" type="string"></param>
        </node>

    <!--     click_demo_high_speed.launch -->

    <node pkg="general_planner" name="fsm_node" type="fsm_node" output="screen">
<!--     1. use absolute path -->
<!--         <param name="config_path" value="" type="string"></param> -->
<!--     2. use file name in general_planner/config/... -->
        <param name="config_name" value="static_high_speed.yaml" type="string"></param>
    </node>


    <group if="$(arg rviz)">
        <node pkg="rviz" type="rviz" name="top_down" args="-d $(arg rviz_config)" output="log">
            <remap from="goal" to="/planning/click_goal"/>
        </node>
        <node if="$(arg fpv_rviz)" pkg="rviz" type="rviz" name="fpv"
              args="-d $(find perfect_drone_sim)/rviz/fpv.rviz" output="log">
            <remap from="goal" to="/planning/click_goal"/>
        </node>
    </group>



</launch>
