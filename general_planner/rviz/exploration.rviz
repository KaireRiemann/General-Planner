Panels:
  - Class: rviz/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Sensing1
        - /EPIC Exploration1
        - /Local Planner1
      Splitter Ratio: 0.5
    Tree Height: 820
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
    Expanded:
      - /Interact1
      - /2D Nav Goal1
    Name: Tool Properties
    Splitter Ratio: 0.58
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz/Time
    Name: Time
    SyncMode: 0
    SyncSource: LocalCloud
Preferences:
  PromptSaveOnExit: false
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz/Grid
      Color: 90; 90; 90
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 80
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz/Group
      Displays:
        - Angle Tolerance: 0.1
          Class: rviz/Odometry
          Covariance:
            Orientation:
              Alpha: 0.2
              Color: 255; 255; 127
              Color Style: Unique
              Frame: Local
              Offset: 1
              Scale: 1
              Value: false
            Position:
              Alpha: 0.1
              Color: 204; 51; 204
              Scale: 1
              Value: false
            Value: false
          Enabled: true
          Keep: 1
          Name: Odometry
          Position Tolerance: 0
          Queue Size: 10
          Shape:
            Alpha: 1
            Axes Length: 0.6
            Axes Radius: 0.05
            Color: 255; 25; 0
            Head Length: 0.3
            Head Radius: 0.08
            Shaft Length: 1
            Shaft Radius: 0.03
            Value: Axes
          Topic: /lidar_slam/odom
          Unreliable: false
          Value: true
        - Class: rviz/Marker
          Enabled: true
          Marker Topic: /odom_visualization/robot
          Name: Robot
          Namespaces:
            {}
          Queue Size: 100
          Value: true
        - Alpha: 0.22
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 12
            Min Value: -2
            Value: false
          Axis: Z
          Channel Name: intensity
          Class: rviz/PointCloud2
          Color: 175; 175; 175
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: true
          Invert Rainbow: false
          Max Color: 255; 255; 255
          Min Color: 0; 0; 0
          Name: GlobalCloud
          Position Transformer: XYZ
          Queue Size: 5
          Selectable: true
          Size (Pixels): 2
          Size (m): 0.01
          Style: Points
          Topic: /global_pc
          Unreliable: false
          Use Fixed Frame: true
          Use rainbow: true
          Value: true
        - Alpha: 0.85
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 8
            Min Value: -2
            Value: false
          Axis: Z
          Channel Name: intensity
          Class: rviz/PointCloud2
          Color: 0; 170; 255
          Color Transformer: AxisColor
          Decay Time: 0
          Enabled: true
          Invert Rainbow: false
          Max Color: 255; 255; 255
          Min Color: 0; 0; 0
          Name: LocalCloud
          Position Transformer: XYZ
          Queue Size: 2
          Selectable: true
          Size (Pixels): 3
          Size (m): 0.04
          Style: Points
          Topic: /cloud_registered
          Unreliable: false
          Use Fixed Frame: true
          Use rainbow: true
          Value: true
      Enabled: true
      Name: Sensing
    - Class: rviz/Group
      Displays:
        - Class: rviz/MarkerArray
          Enabled: true
          Marker Topic: /fsm_node/visualization/exploration/frontiers
          Name: FrontierClusters
          Namespaces:
            {}
          Queue Size: 10
          Value: true
        - Class: rviz/MarkerArray
          Enabled: true
          Marker Topic: /fsm_node/visualization/exploration/topo_graph
          Name: TopoGraph
          Namespaces:
            {}
          Queue Size: 10
          Value: true
        - Class: rviz/MarkerArray
          Enabled: true
          Marker Topic: /fsm_node/visualization/exploration/viewpoints
          Name: Viewpoints
          Namespaces:
            {}
          Queue Size: 10
          Value: true
        - Class: rviz/MarkerArray
          Enabled: true
          Marker Topic: /fsm_node/visualization/exploration/global_tour
          Name: GlobalTour
          Namespaces:
            {}
          Queue Size: 10
          Value: true
        - Class: rviz/MarkerArray
          Enabled: true
          Marker Topic: /fsm_node/visualization/frontend_path
          Name: GuidePath
          Namespaces:
            {}
          Queue Size: 10
          Value: true
      Enabled: true
      Name: EPIC Exploration
    - Class: rviz/Group
      Displays:
        - Class: rviz/MarkerArray
          Enabled: true
          Marker Topic: /fsm_node/visualization/goal
          Name: CurrentGoal
          Namespaces:
            {}
          Queue Size: 20
          Value: true
        - Class: rviz/MarkerArray
          Enabled: true
          Marker Topic: /fsm_node/visualization/committed_traj
          Name: CommittedTrajectory
          Namespaces:
            {}
          Queue Size: 20
          Value: true
        - Class: rviz/MarkerArray
          Enabled: true
          Marker Topic: /fsm_node/visualization/exp_sfc
          Name: SafeCorridor
          Namespaces:
            {}
          Queue Size: 20
          Value: true
        - Class: rviz/MarkerArray
          Enabled: false
          Marker Topic: /fsm_node/visualization/backup_traj
          Name: BackupTrajectory
          Namespaces:
            {}
          Queue Size: 20
          Value: false
        - Class: rviz/MarkerArray
          Enabled: false
          Marker Topic: /fsm_node/visualization/astar_debug
          Name: AstarDebug
          Namespaces:
            {}
          Queue Size: 20
          Value: false
      Enabled: true
      Name: Local Planner
    - Class: rviz/TF
      Enabled: false
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 1
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree:
        {}
      Update Interval: 0
      Value: false
  Enabled: true
  Global Options:
    Background Color: 36; 42; 44
    Default Light: true
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
    - Class: rviz/PublishPoint
      Single click: true
      Topic: /clicked_point
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 58
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 6
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.68
      Target Frame: <Fixed Frame>
      Yaw: 5.42
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 1080
  Hide Left Dock: false
  Hide Right Dock: true
  QMainWindow State: 
  Selection:
    collapsed: false
  Time:
    collapsed: false
  Tool Properties:
    collapsed: false
  Views:
    collapsed: true
  Width: 1920
  X: 0
  Y: 0
